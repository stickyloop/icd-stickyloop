---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mi Empresa",
  description = "Encuéntranos en nuestras redes sociales",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/png" href="/Logo1.png" />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    color: #111111;
    background: #f4f4f5;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    min-height: 100%;
  }

  body {
    min-height: 100vh;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }
</style>